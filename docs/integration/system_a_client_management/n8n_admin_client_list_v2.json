    {
      "parameters": {"jsCode": "const auth = String($input.first().json.headers?.authorization || '');\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nreturn [{ json: { token: match ? match[1] : '' } }];"},
      "id": "c85b6ab8-455a-481f-9b9a-d22b3c02f8d0", "name": "Extrair Token", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-480, 0]
    },
    {
      "parameters": {"operation": "executeQuery", "query": "SELECT f.id FROM security_sessoes_funcionarios AS s JOIN funcionarios AS f ON f.id = s.funcionario_id WHERE s.token_hash = SHA2($1, 256) AND s.expira_em > UTC_TIMESTAMP() AND s.revogado_em IS NULL AND f.status = 'Ativo' LIMIT 1;", "options": {"queryReplacement": "={{ [$json.token] }}"}},
      "id": "f1213eeb-c32e-46bc-a107-805d40764ec0", "name": "Validar Sessao Admin", "type": "n8n-nodes-base.mySql", "typeVersion": 2.1, "position": [-240, 0], "alwaysOutputData": true
    },
    {
      "parameters": {"conditions": {"boolean": [{"value1": "={{ Boolean($json.id) }}", "value2": true}]}},
      "id": "a0761105-8b71-4cb6-b70e-bc21761ef8a8", "name": "Sessao Valida?", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [0, 0]
    },
    {
      "parameters": {"operation": "executeQuery", "query": "SELECT c.id, c.nome_cliente, c.nome_fantasia, c.documento_fiscal_canonico AS cnpj_cpf, c.whatsapp, c.telefone, c.status, MIN(e.email) AS email, MIN(e.email) AS emails, GROUP_CONCAT(e.email ORDER BY e.id SEPARATOR ', ') AS emails_autorizados FROM clientes AS c LEFT JOIN clientes_emails_autorizados AS e ON e.cliente_id = c.id GROUP BY c.id, c.nome_cliente, c.nome_fantasia, c.documento_fiscal_canonico, c.whatsapp, c.telefone, c.status ORDER BY c.nome_cliente ASC;", "options": {}},
      "id": "56b69eca-68aa-4457-bb9b-cdf36b28791c", "name": "Buscar Todos os Clientes", "type": "n8n-nodes-base.mySql", "typeVersion": 2.1, "position": [240, -96]
