      "id": "1c30e696-95b0-4fe0-944f-c4e8250c2022", "name": "GET Clientes", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-720, 0], "webhookId": "d1479cbe-993f-40e5-bbd6-4073cb9f7ab2"
    },
    {
      "parameters": {"jsCode": "const auth = String($input.first().json.headers?.authorization || '');\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nreturn [{ json: { token: match ? match[1] : '' } }];"},
      "id": "c85b6ab8-455a-481f-9b9a-d22b3c02f8d0", "name": "Extrair Token", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-480, 0]
    },
    {
      "parameters": {"operation": "executeQuery", "query": "CALL sp_admin_cliente_list($1);", "options": {"queryReplacement": "={{ [$json.token] }}"}},
      "id": "f1213eeb-c32e-46bc-a107-805d40764ec0", "name": "Listar Clientes Autorizados", "type": "n8n-nodes-base.mySql", "typeVersion": 2.1, "position": [-240, 0], "alwaysOutputData": true
    },
    {
      "parameters": {"jsCode": "const candidates = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]).filter((value) => value && typeof value === 'object');\nconst meta = candidates.find((value) => Number(value.is_meta || 0) === 1 && Object.prototype.hasOwnProperty.call(value, 'result'));\nif (!meta) return [{ json: { success: 0, result: 'internal_error', data: [], request_id: null } }];\nconst data = candidates.filter((value) => Number(value.is_meta || 0) === 0).map(({ success, result, request_id, is_meta, ...client }) => client);\nreturn [{ json: { success: meta.success, result: meta.result, request_id: meta.request_id, data } }];"},
      "id": "8b1ce4e2-7cc1-4d77-a846-75dddf82c77f", "name": "Normalizar Resultado", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [0, 0]
    },
    {
      "parameters": {"conditions": {"boolean": [{"value1": "={{ Number($json.success || 0) === 1 }}", "value2": true}]}},
      "id": "a0761105-8b71-4cb6-b70e-bc21761ef8a8", "name": "Listagem Autorizada?", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [240, 0]
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={{ { success: true, data: $json.data } }}", "options": {"responseHeaders": {"entries": [{"name": "Access-Control-Allow-Origin", "value": "https://serdial21.com"}]}}},
      "id": "d9f27f68-ebf5-4131-8019-d3b0c0e02345", "name": "Responder Lista", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [480, -96]
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={{ { success: false, message: $json.result === 'forbidden' ? 'Voce nao tem permissao para visualizar clientes.' : $json.result === 'unauthorized' ? 'Sessao expirada ou invalida. Faca login novamente.' : 'Nao foi possivel listar os clientes.', request_id: $json.request_id || null } }}", "options": {"responseCode": "={{ $json.result === 'unauthorized' ? 401 : $json.result === 'forbidden' ? 403 : 500 }}", "responseHeaders": {"entries": [{"name": "Access-Control-Allow-Origin", "value": "https://serdial21.com"}]}}},
