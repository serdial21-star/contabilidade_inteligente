    {
      "parameters": {
        "jsCode": "const req = $input.first().json;\nconst body = req.body || {};\nconst auth = String(req.headers?.authorization || '');\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nconst adminToken = match ? match[1] : '';\nconst text = (value) => String(value ?? '').trim();\nconst nome = text(body.nome_cliente);\nconst email = text(body.email).toLowerCase();\nconst status = text(body.status || 'Ativo');\nconst whatsapp = text(body.whatsapp).replace(/\\D/g, '');\nconst rawDocument = text(body.cnpj_cpf || body.cnpj).toUpperCase();\nif ([...rawDocument].some((char) => !/[0-9A-Z.\\/ -]/.test(char))) throw new Error('Documento fiscal invalido.');\nconst documento = rawDocument.replace(/[.\\/ -]/g, '');\nconst cpfDigit = (digits, initialWeight) => { let total = 0; for (let i = 0; i < digits.length; i++) total += Number(digits[i]) * (initialWeight - i); const remainder = total % 11; return remainder < 2 ? 0 : 11 - remainder; };\nconst validCpf = (value) => { if (!/^\\d{11}$/.test(value) || /^(\\d)\\1{10}$/.test(value)) return false; const d1 = cpfDigit(value.slice(0, 9), 10); const d2 = cpfDigit(value.slice(0, 9) + d1, 11); return value.endsWith(`${d1}${d2}`); };\nconst cnpjDigit = (base, weights) => { const total = [...base].reduce((sum, char, index) => sum + (char.charCodeAt(0) - 48) * weights[index], 0); const remainder = total % 11; return remainder < 2 ? 0 : 11 - remainder; };\nconst validCnpj = (value) => { if (!/^[0-9A-Z]{12}\\d{2}$/.test(value) || (/^\\d{14}$/.test(value) && /^(\\d)\\1{13}$/.test(value))) return false; const w1 = [5,4,3,2,9,8,7,6,5,4,3,2]; const w2 = [6,5,4,3,2,9,8,7,6,5,4,3,2]; const d1 = cnpjDigit(value.slice(0, 12), w1); const d2 = cnpjDigit(value.slice(0, 12) + d1, w2); return value.endsWith(`${d1}${d2}`); };\nif (!adminToken) throw new Error('Sessao administrativa ausente ou invalida.');\nif (nome.length < 2 || nome.length > 150) throw new Error('Nome invalido.');\nif (email.length > 100 || !/^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$/.test(email)) throw new Error('E-mail invalido.');\nif (!['Ativo', 'Inativo', 'Lead'].includes(status)) throw new Error('Status invalido.');\nif (status !== 'Lead' && !documento) throw new Error('CPF/CNPJ obrigatorio para cliente ativo ou inativo.');\nif (documento && !validCpf(documento) && !validCnpj(documento)) throw new Error('CPF/CNPJ com digitos verificadores invalidos.');\nif (whatsapp && !/^\\d{10,15}$/.test(whatsapp)) throw new Error('WhatsApp invalido.');\nreturn [{ json: { admin_token: adminToken, nome_cliente: nome, email, documento, status, whatsapp, folder_name: nome } }];"
      },
