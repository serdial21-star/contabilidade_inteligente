        "jsCode": "const candidates = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]);\nconst row = candidates.find((value) => value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, 'request_id'));\nreturn [{ json: row ?? { success: 0, result: 'internal_error', cliente_id: null, should_send: 0, delivery_email: null, reset_token: null, request_id: null } }];"
      },
