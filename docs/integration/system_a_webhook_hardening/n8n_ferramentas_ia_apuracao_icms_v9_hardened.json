                  {
                      "parameters":  {
                                         "jsCode":  "if (!$input.item.binary) throw new Error(\u0027ERRO: Nenhum arquivo foi recebido no Webhook.\u0027);\n\nconst binaryKeys = Object.keys($input.item.binary || {});\nif (!binaryKeys.length) throw new Error(\u0027ERRO: Nenhum binario encontrado no item de entrada.\u0027);\n\nconst nomeDoCampo = binaryKeys[0];\nconst binInfo = $input.item.binary[nomeDoCampo] || {};\nconst nomeArquivo = binInfo.fileName || \u0027\u0027;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, nomeDoCampo);\n\nlet csvString = \u0027\u0027;\ntry {\n  csvString = buffer.toString(\u0027utf8\u0027);\n  if ((csvString.match(/\\uFFFD/g) || []).length \u003e 5) {\n    csvString = buffer.toString(\u0027latin1\u0027);\n  }\n} catch (e) {\n  csvString = buffer.toString(\u0027latin1\u0027);\n}\n\ncsvString = csvString.replace(/^\\uFEFF+/, \u0027\u0027);\nconst linhas = csvString.split(/\\r?\\n/);\n\nconst MESES_NUM = {\n  1: \u0027JANEIRO\u0027, 2: \u0027FEVEREIRO\u0027, 3: \u0027MARCO\u0027, 4: \u0027ABRIL\u0027,\n  5: \u0027MAIO\u0027, 6: \u0027JUNHO\u0027, 7: \u0027JULHO\u0027, 8: \u0027AGOSTO\u0027,\n  9: \u0027SETEMBRO\u0027, 10: \u0027OUTUBRO\u0027, 11: \u0027NOVEMBRO\u0027, 12: \u0027DEZEMBRO\u0027\n};\n\nconst MARCO_KEY = \u0027MAR\\u00C7O\u0027;\n\nconst criarLinhaVazia = (cfop) =\u003e ({\n  CFOP: cfop, JANEIRO: 0, FEVEREIRO: 0, [MARCO_KEY]: 0, ABRIL: 0,\n  MAIO: 0, JUNHO: 0, JULHO: 0, AGOSTO: 0, SETEMBRO: 0,\n  OUTUBRO: 0, NOVEMBRO: 0, DEZEMBRO: 0\n});\n\nconst parseValorBR = (valor) =\u003e {\n  if (valor === null || valor === undefined) return 0;\n  let s = String(valor).trim().replace(/\\s/g, \u0027\u0027);\n  if (!s) return 0;\n  const hasComma = s.includes(\u0027,\u0027);\n  const hasDot = s.includes(\u0027.\u0027);\n  if (hasComma \u0026\u0026 hasDot) {\n    if (s.lastIndexOf(\u0027,\u0027) \u003e s.lastIndexOf(\u0027.\u0027)) {\n      s = s.replace(/\\./g, \u0027\u0027).replace(\u0027,\u0027, \u0027.\u0027);\n    } else {\n      s = s.replace(/,/g, \u0027\u0027);\n    }\n  } else if (hasComma) {\n    s = s.replace(/\\./g, \u0027\u0027).replace(\u0027,\u0027, \u0027.\u0027);\n  }\n  s = s.replace(/[^\\d.-]/g, \u0027\u0027);\n  const n = parseFloat(s);\n  return Number.isFinite(n) ? n : 0;\n};\n\nconst detectarDelimitador = (linhas) =\u003e {\n  const amostra = linhas.slice(0, Math.min(15, linhas.length));\n  let scorePV = 0, scoreVirg = 0;\n  for (const l of amostra) {\n    scorePV += (l.match(/;/g) || []).length;\n    scoreVirg += (l.match(/,/g) || []).length;\n  }\n  return scorePV \u003e= scoreVirg ? \u0027;\u0027 : \u0027,\u0027;\n};\n\nconst delimiter = detectarDelimitador(linhas);\n\nconst resumo = {};\nconst anosEncontrados = new Set();\nlet mesAtual = null;\nlet emSecaoDados = false;\n\nconst reSecao = /(?:ENTRADAS|SA[I\\u00CDIDAS]DAS)\\s+(\\d{1,2})\\/(\\d{4})/i;\nconst reCfopHeader = /^CFOP[;,]/;\nconst reParar = /^(Subtotais|Total\\b|1\\.\\d{2}\\s|2\\.\\d{2}\\s|3\\.\\d{2}\\s|5\\.\\d{2}\\s|6\\.\\d{2}\\s|7\\.\\d{2}\\s)/i;\n\nfor (const linhaRaw of linhas) {\n  const linha = linhaRaw.trim();\n  if (!linha) continue;\n\n  const mSecao = linha.match(reSecao);\n  if (mSecao) {\n    mesAtual = parseInt(mSecao[1], 10);\n    anosEncontrados.add(parseInt(mSecao[2], 10));\n    emSecaoDados = false;\n    continue;\n  }\n\n  if (reCfopHeader.test(linha)) {\n    emSecaoDados = true;\n    continue;\n  }\n\n  if (reParar.test(linha)) {\n    emSecaoDados = false;\n    continue;\n  }\n\n  if (!emSecaoDados || mesAtual === null) continue;\n\n  const cols = linhaRaw.split(delimiter);\n  const cfop = (cols[0] || \u0027\u0027).trim().replace(/\\D/g, \u0027\u0027);\n  if (!cfop || cfop.length !== 4) continue;\n\n  const vrContabil = parseValorBR(cols[1]);\n\n  if (!resumo[cfop]) resumo[cfop] = criarLinhaVazia(cfop);\n\n  let nomeMes = MESES_NUM[mesAtual];\n  if (nomeMes === \u0027MARCO\u0027) nomeMes = MARCO_KEY;\n\n  if (nomeMes) {\n    resumo[cfop][nomeMes] = Number((resumo[cfop][nomeMes] + vrContabil).toFixed(2));\n  }\n}\n\nif (anosEncontrados.size \u003e 1) {\n  throw new Error(`ERRO: O arquivo contem dados de anos diferentes (${Array.from(anosEncontrados).sort().join(\u0027, \u0027)}). A planilha suporta apenas 1 ano por vez.`);\n}\n\nconst listaAtualizacao = Object.keys(resumo)\n  .sort((a, b) =\u003e Number(a) - Number(b))\n  .map(cfop =\u003e ({\n    CFOP: resumo[cfop].CFOP,\n    JANEIRO: Number(resumo[cfop].JANEIRO.toFixed(2)),\n    FEVEREIRO: Number(resumo[cfop].FEVEREIRO.toFixed(2)),\n    [MARCO_KEY]: Number(resumo[cfop][MARCO_KEY].toFixed(2)),\n    ABRIL: Number(resumo[cfop].ABRIL.toFixed(2)),\n    MAIO: Number(resumo[cfop].MAIO.toFixed(2)),\n    JUNHO: Number(resumo[cfop].JUNHO.toFixed(2)),\n    JULHO: Number(resumo[cfop].JULHO.toFixed(2)),\n    AGOSTO: Number(resumo[cfop].AGOSTO.toFixed(2)),\n    SETEMBRO: Number(resumo[cfop].SETEMBRO.toFixed(2)),\n    OUTUBRO: Number(resumo[cfop].OUTUBRO.toFixed(2)),\n    NOVEMBRO: Number(resumo[cfop].NOVEMBRO.toFixed(2)),\n    DEZEMBRO: Number(resumo[cfop].DEZEMBRO.toFixed(2))\n  }));\n\nif (!listaAtualizacao.length) {\n  throw new Error(`Nenhum dado valido foi consolidado. Arquivo: ${nomeArquivo}`);\n}\n\nreturn [{\n  json: {\n    listaAtualizacao,\n    totalCFOPs: listaAtualizacao.length\n  }\n}];"
                                     },
