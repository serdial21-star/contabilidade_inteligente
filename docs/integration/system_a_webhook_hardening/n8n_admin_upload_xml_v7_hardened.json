                      "id":  "eef67772-3371-4b54-86f0-668e27ba7894",
                      "name":  "Buscar Pasta Cliente",
                      "type":  "n8n-nodes-base.mySql",
                      "typeVersion":  2,
                      "position":  [
                                       736,
                                       -160
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const pastaItems = $input.all();\nconst fiscais = $(\u0027Extrair Dados NFe\u0027).all();\nconst separados = $(\u0027Separar XMLs\u0027).all();\n\nconst out = [];\n\nfor (let i = 0; i \u003c pastaItems.length; i++) {\n  const pasta = pastaItems[i].json ?? {};\n  const fiscal = fiscais[i]?.json ?? {};\n  const binario = separados[i]?.binary ?? {};\n\n  if (!pasta.id_pasta_raiz) {\n    throw new Error(`id_pasta_raiz não encontrado no item ${i + 1}`);\n  }\n\n  if (!binario.data) {\n    throw new Error(`Binário \u0027data\u0027 não encontrado no item ${i + 1}`);\n  }\n\n  out.push({\n    json: {\n      ...fiscal,\n      id_pasta_raiz: pasta.id_pasta_raiz\n    },\n    binary: {\n      data: binario.data\n    }\n  });\n}\n\nreturn out;\n"
                                     },
