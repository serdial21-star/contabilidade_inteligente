                  {
                      "parameters":  {
                                         "jsCode":  "const input = $(\u0027Receber XML\u0027).first().json ?? {};\nconst headers = input.headers ?? {};\nconst auth = String(headers.authorization ?? headers.Authorization ?? \u0027\u0027);\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nconst body = input.body && typeof input.body === \u0027object\u0027 ? input.body : input;\nconst rawClientId = String(body.cliente_id ?? \u0027\u0027);\nconst clienteId = /^[1-9][0-9]*$/.test(rawClientId) ? Number(rawClientId) : 0;\nreturn [{ json: { token: match ? match[1] : \u0027\u0027, cliente_id: Number.isSafeInteger(clienteId) ? clienteId : 0, invalid_client: !Number.isSafeInteger(clienteId) || clienteId < 1 } }];"
                                     },
