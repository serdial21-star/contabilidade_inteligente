                  {
                      "parameters":  {
                                         "jsCode":  "const driveItems = $input.all();\nconst fiscais = $(\u0027Consolidar Dados + Binário\u0027).all();\n\nconst out = [];\n\nfor (let i = 0; i \u003c driveItems.length; i++) {\n  const drive = driveItems[i].json ?? {};\n  const fiscal = fiscais[i]?.json ?? {};\n\n  if (!fiscal.cliente_id) {\n    throw new Error(`cliente_id não encontrado no item ${i + 1}`);\n  }\n\n  out.push({\n    json: {\n      cliente_id: fiscal.cliente_id ?? null,\n      tipo_operacao: fiscal.tipo_operacao ?? \u0027Entrada\u0027,\n      nome_arquivo: fiscal.nome_arquivo ?? \u0027\u0027,\n\n      chave_acesso: fiscal.chave_acesso ?? \u0027\u0027,\n      numero_nota: fiscal.numero_nota ?? \u0027\u0027,\n      serie: fiscal.serie ?? \u0027\u0027,\n      data_emissao: fiscal.data_emissao ?? null,\n\n      emitente_nome: fiscal.emitente_nome ?? \u0027\u0027,\n      emitente_cnpj: fiscal.emitente_cnpj ?? \u0027\u0027,\n      destinatario_nome: fiscal.destinatario_nome ?? \u0027\u0027,\n      destinatario_cnpj: fiscal.destinatario_cnpj ?? \u0027\u0027,\n\n      valor_total_nota: Number(fiscal.valor_total_nota ?? 0),\n      base_icms: Number(fiscal.base_icms ?? 0),\n      valor_icms: Number(fiscal.valor_icms ?? 0),\n      valor_pis: Number(fiscal.valor_pis ?? 0),\n      valor_cofins: Number(fiscal.valor_cofins ?? 0),\n\n      arquivo_drive_id: drive.id ?? \u0027\u0027,\n      arquivo_url_drive: drive.webViewLink ?? drive.webContentLink ?? drive.id ?? \u0027\u0027\n    }\n  });\n}\n\nreturn out;\n"
                                     },
                      "id":  "0a2608c7-91dc-47be-881a-6a6c33c158c1",
                      "name":  "Consolidar Dados Banco",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1392,
                                       -160
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nconst text = (value) => String(value ?? \u0027\u0027);\n\nreturn items.map((item) =\u003e {\n  const j = item.json ?? {};\n  return {\n    json: {\n      cliente_id: Number(j.cliente_id ?? 0),\n      tipo_operacao: text(j.tipo_operacao),\n      nome_arquivo: text(j.nome_arquivo),\n      chave_acesso: text(j.chave_acesso),\n      numero_nota: text(j.numero_nota),\n      serie: text(j.serie),\n      data_emissao: j.data_emissao ? text(j.data_emissao) : null,\n      emitente_nome: text(j.emitente_nome),\n      emitente_cnpj: text(j.emitente_cnpj),\n      destinatario_nome: text(j.destinatario_nome),\n      destinatario_cnpj: text(j.destinatario_cnpj),\n      valor_total_nota: Number(j.valor_total_nota ?? 0),\n      base_icms: Number(j.base_icms ?? 0),\n      valor_icms: Number(j.valor_icms ?? 0),\n      valor_pis: Number(j.valor_pis ?? 0),\n      valor_cofins: Number(j.valor_cofins ?? 0),\n      arquivo_drive_id: text(j.arquivo_drive_id),\n      arquivo_url_drive: text(j.arquivo_url_drive)\n    }\n  };\n});\n"
                                     },
