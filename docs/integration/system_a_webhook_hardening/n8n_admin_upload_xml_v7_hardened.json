                      "id":  "e63a1b2b-20ef-4571-bdf4-b440594fec71",
                      "name":  "Receber XML",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  2,
                      "position":  [
                                       -160,
                                       -160
                                   ],
                      "webhookId":  "b1de6a37-7815-48c0-8fe1-00b9db714d65"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const inputItems = $input.all();\n\nif (!inputItems.length) {\n  throw new Error(\u0027Nenhum item recebido do Webhook.\u0027);\n}\n\nconst webhookItem = inputItems[0];\nconst inputJson = webhookItem.json ?? {};\nconst body =\n  inputJson.body \u0026\u0026 typeof inputJson.body === \u0027object\u0027\n    ? inputJson.body\n    : inputJson;\n\nconst binaries = webhookItem.binary ?? {};\nconst fileKeys = Object.keys(binaries)\n  .filter((key) =\u003e /^arquivos\\d+$/i.test(key))\n  .sort((a, b) =\u003e {\n    const na = Number((a.match(/\\d+/) || [\u00270\u0027])[0]);\n    const nb = Number((b.match(/\\d+/) || [\u00270\u0027])[0]);\n    return na - nb;\n  });\n\nif (fileKeys.length === 0) {\n  throw new Error(\u0027Nenhum arquivo XML encontrado. Esperado: arquivos0, arquivos1, arquivos2...\u0027);\n}\n\nconst output = [];\n\nfor (const key of fileKeys) {\n  const bin = binaries[key];\n  if (!bin) continue;\n\n  let buffer;\n  try {\n    buffer = await this.helpers.getBinaryDataBuffer(0, key);\n  } catch (error) {\n    throw new Error(`Falha ao ler o binário real do campo ${key}: ${error.message}`);\n  }\n\n  let xmlString = buffer.toString(\u0027utf8\u0027);\n\n  xmlString = xmlString\n    .replace(/^\\uFEFF/, \u0027\u0027)\n    .replace(/^\\s+/, \u0027\u0027)\n    .replace(/^[^\u003c]+(?=\u003c)/, \u0027\u0027)\n    .trim();\n\n  if (!xmlString) {\n    throw new Error(`O arquivo do campo ${key} foi lido, mas está vazio.`);\n  }\n\n  if (!xmlString.startsWith(\u0027\u003c\u0027)) {\n    throw new Error(`O conteúdo do campo ${key} não parece ser XML válido. Início encontrado: ${xmlString.substring(0, 80)}`);\n  }\n\n  output.push({\n    json: {\n      cliente_id: body.cliente_id ?? null,\n      tipo_operacao: body.tipo_operacao ?? \u0027Entrada\u0027,\n      upload_field: key,\n      nome_arquivo: bin.fileName ?? `${key}.xml`,\n      mime_type: bin.mimeType ?? \u0027application/xml\u0027,\n      file_extension: bin.fileExtension ?? \u0027xml\u0027,\n      xml_text: xmlString\n    },\n    binary: {\n      data: bin\n    },\n    pairedItem: {\n      item: 0\n    }\n  });\n}\n\nreturn output;\n"
                                     },
                      "id":  "79691182-fd4a-49d1-acf6-fed3a98dfe14",
                      "name":  "Separar XMLs",
