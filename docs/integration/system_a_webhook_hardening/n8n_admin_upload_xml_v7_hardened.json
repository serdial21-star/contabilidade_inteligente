                      "id":  "9ff0318e-1883-47b3-af9b-ac4c1661db2c",
                      "name":  "Converter XML",
                      "type":  "n8n-nodes-base.xml",
                      "typeVersion":  1,
                      "position":  [
                                       288,
                                       -160
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\n\nfunction money(v) {\n  const n = parseFloat(v);\n  return Number.isFinite(n) ? n : 0;\n}\n\nconst origemItems = $(\u0027Separar XMLs\u0027).all();\n\nfor (let i = 0; i \u003c items.length; i++) {\n  const data = items[i].json ?? {};\n\n  let nfe = {};\n\n  if (data.nfeProc?.NFe?.infNFe) {\n    nfe = data.nfeProc.NFe.infNFe;\n  } else if (data.NFe?.infNFe) {\n    nfe = data.NFe.infNFe;\n  } else if (data.infNFe) {\n    nfe = data.infNFe;\n  } else {\n    throw new Error(`Estrutura NFe inválida no item ${i + 1}`);\n  }\n\n  const ide = nfe.ide ?? {};\n  const emit = nfe.emit ?? {};\n  const dest = nfe.dest ?? {};\n  const tot = nfe.total?.ICMSTot ?? {};\n\n  let chave = \u0027\u0027;\n  if (nfe.$?.Id) {\n    chave = String(nfe.$.Id).replace(/^NFe/, \u0027\u0027);\n  } else if (nfe.Id) {\n    chave = String(nfe.Id).replace(/^NFe/, \u0027\u0027);\n  }\n\n  const origem = origemItems[i]?.json ?? {};\n\n  items[i].json = {\n    cliente_id: origem.cliente_id ?? null,\n    tipo_operacao: origem.tipo_operacao ?? \u0027Entrada\u0027,\n    nome_arquivo: origem.nome_arquivo ?? \u0027\u0027,\n    upload_field: origem.upload_field ?? \u0027\u0027,\n\n    chave_acesso: chave,\n    numero_nota: ide.nNF ?? \u0027\u0027,\n    serie: ide.serie ?? \u0027\u0027,\n    data_emissao: ide.dhEmi\n      ? String(ide.dhEmi).substring(0, 19).replace(\u0027T\u0027, \u0027 \u0027)\n      : null,\n\n    emitente_nome: emit.xNome ?? \u0027\u0027,\n    emitente_cnpj: emit.CNPJ ?? emit.CPF ?? \u0027\u0027,\n\n    destinatario_nome: dest.xNome ?? \u0027\u0027,\n    destinatario_cnpj: dest.CNPJ ?? dest.CPF ?? \u0027\u0027,\n\n    valor_total_nota: money(tot.vNF),\n    base_icms: money(tot.vBC),\n    valor_icms: money(tot.vICMS),\n    valor_pis: money(tot.vPIS),\n    valor_cofins: money(tot.vCOFINS)\n  };\n}\n\nreturn items;\n"
                                     },
