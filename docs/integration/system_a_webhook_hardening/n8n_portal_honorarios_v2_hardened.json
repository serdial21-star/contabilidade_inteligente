                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT hp.id, hp.competencia, hp.valor, hp.data_vencimento, hp.data_pagamento, hp.status, hp.link_comprovante, hp.link_boleto, hp.link_nota_fiscal, hp.link_recibo, hp.tipo_documento_fiscal, hp.numero_nota_fiscal, hp.numero_recibo, hc.descricao AS origem FROM honorarios_parcelas hp JOIN honorarios_contratos hc ON hc.id = hp.contrato_id WHERE hp.cliente_id = $1 ORDER BY hp.data_vencimento DESC LIMIT 50;",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$json.cliente_id] }}"
                                                     }
                                     },
                      "id":  "efd09fb2-da38-4c9c-af0f-b7e5169c6aaf",
                      "name":  "SQL historico parcelas",
