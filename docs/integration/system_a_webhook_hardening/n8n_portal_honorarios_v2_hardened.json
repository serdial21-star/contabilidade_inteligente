                                       480,
                                       80
                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT competencia, valor, data_vencimento, status FROM honorarios_parcelas WHERE cliente_id = $1 AND status IN (\u0027pendente\u0027, \u0027atrasado\u0027) ORDER BY data_vencimento ASC LIMIT 1;",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$(\u0027SQL validar token\u0027).first().json.cliente_id] }}"
                                                     }
                                     },
                      "id":  "08ec643f-c707-4c30-9230-38d55543c537",
                      "name":  "SQL proxima fatura",
                      "type":  "n8n-nodes-base.mySql",
                      "typeVersion":  2.4,
                      "position":  [
                                       720,
                                       80
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const parcelas = $(\u0027SQL historico parcelas\u0027).all().map(i =\u003e i.json);\nconst proximaArr = $(\u0027SQL proxima fatura\u0027).all();\nconst proxima = proximaArr.length \u003e 0 ? proximaArr[0].json : null;\nconst atrasadas = parcelas.filter(p =\u003e p.status === \u0027atrasado\u0027).length;\n\nreturn [{ json: {\n  success: true,\n  proxima_fatura: proxima,\n  situacao: {\n    em_dia: atrasadas === 0,\n    parcelas_atrasadas: atrasadas\n  },\n  parcelas: parcelas,\n  total: parcelas.length\n}}];"
                                     },
