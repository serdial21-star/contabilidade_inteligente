                                       256,
                                       -80
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const input = $(\u0027Normalizar Entrada CND\u0027).first().json;\nconst clienteId = Number($json.id ?? 0);\nif (!Number.isSafeInteger(clienteId) || clienteId < 1) {\n  throw new Error(\u0027Cliente indisponivel para a integracao CND.\u0027);\n}\nreturn [{ json: { ...input, cliente_id: clienteId } }];"
                                     },
                      "id":  "807c9462-cb60-481f-840a-725d4ba9e235",
                      "name":  "Code - Montar Upsert CND",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       512,
                                       -80
                                   ]
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "INSERT INTO certidoes_clientes (cliente_id, tipo_id, data_emissao, data_vencimento, status, observacoes) VALUES ($1, $2, $3, $4, $5, \u0027Extraído via IA Gemini\u0027) ON DUPLICATE KEY UPDATE data_vencimento = VALUES(data_vencimento), status = VALUES(status), updated_at = UTC_TIMESTAMP();",
                                         "options":  {
                                                         "queryReplacement":  "={{ [$json.cliente_id, $json.tipo_id, $json.data_emissao, $json.data_vencimento, $json.status] }}"
                                                     }
                                     },
                      "id":  "ef2e15fd-2236-461f-9398-167c89153f4a",
                      "name":  "MySQL - Salvar CND",
                      "type":  "n8n-nodes-base.mySql",
                      "typeVersion":  2.4,
                      "position":  [
                                       752,
                                       -80
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const body = $(\u0027Webhook - Integracao Colab\u0027).first().json.body ?? {};\nconst cnpj = String(body.cnpj ?? \u0027\u0027).trim().toUpperCase();\nconst tipoId = Number(body.tipo_id ?? 0);\nif (!cnpj || !Number.isSafeInteger(tipoId) || tipoId < 1) {\n  throw new Error(\u0027Entrada CND invalida.\u0027);\n}\nreturn [{ json: { cnpj, tipo_id: tipoId, data_emissao: body.data_emissao ?? null, data_vencimento: body.data_vencimento ?? null, status: String(body.status ?? \u0027\u0027) } }];"
                                     },
