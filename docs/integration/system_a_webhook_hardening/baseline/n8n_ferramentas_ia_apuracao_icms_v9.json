      "parameters": {
        "jsCode": "if (!$input.item.binary) throw new Error('ERRO: Nenhum arquivo foi recebido no Webhook.');\n\nconst binaryKeys = Object.keys($input.item.binary || {});\nif (!binaryKeys.length) throw new Error('ERRO: Nenhum binario encontrado no item de entrada.');\n\nconst nomeDoCampo = binaryKeys[0];\nconst binInfo = $input.item.binary[nomeDoCampo] || {};\nconst nomeArquivo = binInfo.fileName || '';\nconst buffer = await this.helpers.getBinaryDataBuffer(0, nomeDoCampo);\n\nlet csvString = '';\ntry {\n  csvString = buffer.toString('utf8');\n  if ((csvString.match(/\\uFFFD/g) || []).length > 5) {\n    csvString = buffer.toString('latin1');\n  }\n} catch (e) {\n  csvString = buffer.toString('latin1');\n}\n\ncsvString = csvString.replace(/^\\uFEFF+/, '');\nconst linhas = csvString.split(/\\r?\\n/);\n\nconst MESES_NUM = {\n  1: 'JANEIRO', 2: 'FEVEREIRO', 3: 'MARCO', 4: 'ABRIL',\n  5: 'MAIO', 6: 'JUNHO', 7: 'JULHO', 8: 'AGOSTO',\n  9: 'SETEMBRO', 10: 'OUTUBRO', 11: 'NOVEMBRO', 12: 'DEZEMBRO'\n};\n\nconst MARCO_KEY = 'MAR\\u00C7O';\n\nconst criarLinhaVazia = (cfop) => ({\n  CFOP: cfop, JANEIRO: 0, FEVEREIRO: 0, [MARCO_KEY]: 0, ABRIL: 0,\n  MAIO: 0, JUNHO: 0, JULHO: 0, AGOSTO: 0, SETEMBRO: 0,\n  OUTUBRO: 0, NOVEMBRO: 0, DEZEMBRO: 0\n});\n\nconst parseValorBR = (valor) => {\n  if (valor === null || valor === undefined) return 0;\n  let s = String(valor).trim().replace(/\\s/g, '');\n  if (!s) return 0;\n  const hasComma = s.includes(',');\n  const hasDot = s.includes('.');\n  if (hasComma && hasDot) {\n    if (s.lastIndexOf(',') > s.lastIndexOf('.')) {\n      s = s.replace(/\\./g, '').replace(',', '.');\n    } else {\n      s = s.replace(/,/g, '');\n    }\n  } else if (hasComma) {\n    s = s.replace(/\\./g, '').replace(',', '.');\n  }\n  s = s.replace(/[^\\d.-]/g, '');\n  const n = parseFloat(s);\n  return Number.isFinite(n) ? n : 0;\n};\n\nconst detectarDelimitador = (linhas) => {\n  const amostra = linhas.slice(0, Math.min(15, linhas.length));\n  let scorePV = 0, scoreVirg = 0;\n  for (const l of amostra) {\n    scorePV += (l.match(/;/g) || []).length;\n    scoreVirg += (l.match(/,/g) || []).length;\n  }\n  return scorePV >= scoreVirg ? ';' : ',';\n};\n\nconst delimiter = detectarDelimitador(linhas);\n\nconst resumo = {};\nconst anosEncontrados = new Set();\nlet mesAtual = null;\nlet emSecaoDados = false;\n\nconst reSecao = /(?:ENTRADAS|SA[I\\u00CDIDAS]DAS)\\s+(\\d{1,2})\\/(\\d{4})/i;\nconst reCfopHeader = /^CFOP[;,]/;\nconst reParar = /^(Subtotais|Total\\b|1\\.\\d{2}\\s|2\\.\\d{2}\\s|3\\.\\d{2}\\s|5\\.\\d{2}\\s|6\\.\\d{2}\\s|7\\.\\d{2}\\s)/i;\n\nfor (const linhaRaw of linhas) {\n  const linha = linhaRaw.trim();\n  if (!linha) continue;\n\n  const mSecao = linha.match(reSecao);\n  if (mSecao) {\n    mesAtual = parseInt(mSecao[1], 10);\n    anosEncontrados.add(parseInt(mSecao[2], 10));\n    emSecaoDados = false;\n    continue;\n  }\n\n  if (reCfopHeader.test(linha)) {\n    emSecaoDados = true;\n    continue;\n  }\n\n  if (reParar.test(linha)) {\n    emSecaoDados = false;\n    continue;\n  }\n\n  if (!emSecaoDados || mesAtual === null) continue;\n\n  const cols = linhaRaw.split(delimiter);\n  const cfop = (cols[0] || '').trim().replace(/\\D/g, '');\n  if (!cfop || cfop.length !== 4) continue;\n\n  const vrContabil = parseValorBR(cols[1]);\n\n  if (!resumo[cfop]) resumo[cfop] = criarLinhaVazia(cfop);\n\n  let nomeMes = MESES_NUM[mesAtual];\n  if (nomeMes === 'MARCO') nomeMes = MARCO_KEY;\n\n  if (nomeMes) {\n    resumo[cfop][nomeMes] = Number((resumo[cfop][nomeMes] + vrContabil).toFixed(2));\n  }\n}\n\nif (anosEncontrados.size > 1) {\n  throw new Error(`ERRO: O arquivo contem dados de anos diferentes (${Array.from(anosEncontrados).sort().join(', ')}). A planilha suporta apenas 1 ano por vez.`);\n}\n\nconst listaAtualizacao = Object.keys(resumo)\n  .sort((a, b) => Number(a) - Number(b))\n  .map(cfop => ({\n    CFOP: resumo[cfop].CFOP,\n    JANEIRO: Number(resumo[cfop].JANEIRO.toFixed(2)),\n    FEVEREIRO: Number(resumo[cfop].FEVEREIRO.toFixed(2)),\n    [MARCO_KEY]: Number(resumo[cfop][MARCO_KEY].toFixed(2)),\n    ABRIL: Number(resumo[cfop].ABRIL.toFixed(2)),\n    MAIO: Number(resumo[cfop].MAIO.toFixed(2)),\n    JUNHO: Number(resumo[cfop].JUNHO.toFixed(2)),\n    JULHO: Number(resumo[cfop].JULHO.toFixed(2)),\n    AGOSTO: Number(resumo[cfop].AGOSTO.toFixed(2)),\n    SETEMBRO: Number(resumo[cfop].SETEMBRO.toFixed(2)),\n    OUTUBRO: Number(resumo[cfop].OUTUBRO.toFixed(2)),\n    NOVEMBRO: Number(resumo[cfop].NOVEMBRO.toFixed(2)),\n    DEZEMBRO: Number(resumo[cfop].DEZEMBRO.toFixed(2))\n  }));\n\nif (!listaAtualizacao.length) {\n  throw new Error(`Nenhum dado valido foi consolidado. Arquivo: ${nomeArquivo}`);\n}\n\nreturn [{\n  json: {\n    listaAtualizacao,\n    totalCFOPs: listaAtualizacao.length\n  }\n}];"
      },
