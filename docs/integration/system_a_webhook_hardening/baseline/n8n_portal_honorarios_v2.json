    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst headers = data.headers || {};\nconst authHeader = headers['authorization'] || headers['Authorization'] || '';\n// só letras e números: nada estranho chega ao SQL da validação\nconst token = authHeader.replace(/^Bearer\\s+/i, '').replace(/[^a-zA-Z0-9]/g, '');\nif (!token) {\n  return [{ json: { _token: '', _invalido: true } }];\n}\nreturn [{ json: { _token: token, _invalido: false } }];"
      },
      "id": "8dbe1707-2b9f-46a0-9eba-55f9b5823a8b",
      "name": "Extrair token",
      "type": "n8n-nodes-base.code",
