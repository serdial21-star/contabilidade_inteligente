      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT hp.id, hp.competencia, hp.valor, hp.data_vencimento, hp.data_pagamento, hp.status, hp.link_comprovante, hp.link_boleto, hp.link_nota_fiscal, hp.link_recibo, hp.tipo_documento_fiscal, hp.numero_nota_fiscal, hp.numero_recibo, hc.descricao AS origem FROM honorarios_parcelas hp JOIN honorarios_contratos hc ON hc.id = hp.contrato_id WHERE hp.cliente_id = {{ $json.cliente_id }} ORDER BY hp.data_vencimento DESC LIMIT 50;",
        "options": {}
      },
      "id": "efd09fb2-da38-4c9c-af0f-b7e5169c6aaf",
      "name": "SQL historico parcelas",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        480,
        80
      ],
      "credentials": {
        "mySql": {
          "id": "A8EKwXIiVjrNd53S",
          "name": "MySQL account 3"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT competencia, valor, data_vencimento, status FROM honorarios_parcelas WHERE cliente_id = {{ $('SQL validar token').item.json.cliente_id }} AND status IN ('pendente', 'atrasado') ORDER BY data_vencimento ASC LIMIT 1;",
        "options": {}
      },
      "id": "08ec643f-c707-4c30-9230-38d55543c537",
      "name": "SQL proxima fatura",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        720,
        80
      ],
      "credentials": {
        "mySql": {
          "id": "A8EKwXIiVjrNd53S",
          "name": "MySQL account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const parcelas = $('SQL historico parcelas').all().map(i => i.json);\nconst proximaArr = $('SQL proxima fatura').all();\nconst proxima = proximaArr.length > 0 ? proximaArr[0].json : null;\nconst atrasadas = parcelas.filter(p => p.status === 'atrasado').length;\n\nreturn [{ json: {\n  success: true,\n  proxima_fatura: proxima,\n  situacao: {\n    em_dia: atrasadas === 0,\n    parcelas_atrasadas: atrasadas\n  },\n  parcelas: parcelas,\n  total: parcelas.length\n}}];"
      },
