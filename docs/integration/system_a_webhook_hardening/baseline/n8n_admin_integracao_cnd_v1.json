        "jsCode": "const b = $node[\"Webhook - Integracao Colab\"].json.body;\nconst cliente = $json.id;\n\nreturn [{\n  json: {\n    query: `INSERT INTO certidoes_clientes (cliente_id, tipo_id, data_emissao, data_vencimento, status, observacoes) \n            VALUES (${cliente}, ${b.tipo_id}, '${b.data_emissao}', '${b.data_vencimento}', '${b.status}', 'Extraído via IA Gemini')\n            ON DUPLICATE KEY UPDATE data_vencimento = '${b.data_vencimento}', status = '${b.status}', updated_at = NOW();`\n  }\n}];"
