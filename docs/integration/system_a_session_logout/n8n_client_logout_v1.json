    {
      "parameters": {
        "jsCode": "const auth = String($input.first().json.headers?.authorization || '');\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nreturn [{ json: { token: match ? match[1] : '' } }];"
      },
      "id": "1e0705f4-a654-40cc-868f-d9104782a308",
      "name": "Extrair Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CALL sp_cliente_logout($1);",
        "options": {
          "queryReplacement": "={{ [$json.token] }}"
        }
      },
      "id": "e0c2a97b-108a-4a02-8290-a029ea8c0f45",
      "name": "Revogar Sessao",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.1,
      "position": [
        -240,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const candidates = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]).filter((value) => value && typeof value === 'object');\nconst ok = candidates.some((value) => value.result === 'logged_out');\nreturn [{ json: { ok } }];"
      },
      "id": "09924cd1-46b1-4331-a619-835053603404",
      "name": "Conferir Resultado",
      "type": "n8n-nodes-base.code",
