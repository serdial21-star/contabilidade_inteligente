    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst funcId = Number(body.funcionario_id);\nif (!Number.isInteger(funcId) || funcId <= 0) throw new Error('funcionario_id inválido');\n\nconst modulos = body.modulos || {};\nconst clientes = body.clientes_acesso || {};\n// nomes de módulo/ação: só letras, números e sublinhado\nconst chaveOk = (s) => /^[A-Za-z0-9_]{1,50}$/.test(s);\n\nlet queries = `DELETE FROM permissoes_funcionario_modulos WHERE funcionario_id = ${funcId};\\n`;\nqueries += `DELETE FROM permissoes_funcionario_clientes WHERE funcionario_id = ${funcId};\\n`;\n\n// Montar Inserts de Módulos\nfor (const [mod, acoes] of Object.entries(modulos)) {\n  if (!chaveOk(mod)) throw new Error('módulo inválido');\n  for (const [acao, valor] of Object.entries(acoes || {})) {\n    if (!chaveOk(acao)) throw new Error('ação inválida');\n    const permitido = valor ? 1 : 0;\n    queries += `INSERT INTO permissoes_funcionario_modulos (funcionario_id, modulo, acao, permitido) VALUES (${funcId}, '${mod}', '${acao}', ${permitido});\\n`;\n  }\n}\n\n// Montar Inserts de Clientes\nfor (const [cliId, valor] of Object.entries(clientes)) {\n  const cid = Number(cliId);\n  if (!Number.isInteger(cid) || cid <= 0) throw new Error('cliente inválido');\n  const permitido = valor ? 1 : 0;\n  queries += `INSERT INTO permissoes_funcionario_clientes (funcionario_id, cliente_id, permitido) VALUES (${funcId}, ${cid}, ${permitido});\\n`;\n}\n\nreturn [{ json: { queries: queries } }];"
      },
