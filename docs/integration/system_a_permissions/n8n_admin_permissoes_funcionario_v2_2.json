    {
      "parameters": {
        "jsCode": "function toBool(v) {\n  if (v === true) return true;\n  if (v === false) return false;\n  if (v === 1 || v === '1') return true;\n  if (v === 0 || v === '0') return false;\n  if (typeof v === 'string') return ['true','sim','yes','y','ok'].includes(v.toLowerCase().trim());\n  return Boolean(v);\n}\n\nconst cargoRaw = ($node[\"Validar Sessão\"].json.cargo || '').toString().trim();\nconst cargo = cargoRaw.toLowerCase(); // case-insensitive\n\n// Ler linhas do banco (podem vir vazias)\nconst rowsMod = $items(\"Buscar Módulos\").map(i => i.json || {});\nconst rowsCli = $items(\"Buscar Clientes Acesso\").map(i => i.json || {});\n\nlet modulos = {};\nfor (const r of rowsMod) {\n  const modulo = (r.modulo || '').toString().trim();\n  const acao = (r.acao || '').toString().trim();\n  if (!modulo || !acao) continue;\n  if (!modulos[modulo]) modulos[modulo] = {};\n  modulos[modulo][acao] = toBool(r.permitido);\n}\n\nlet clientesAcesso = {};\nfor (const r of rowsCli) {\n  if (r.cliente_id == null) continue;\n  clientesAcesso[String(r.cliente_id)] = toBool(r.permitido);\n}\n\n// Fallback mínimo por cargo quando vier vazio\nconst hasModulos = modulos && Object.keys(modulos).length > 0;\n\nfunction fallbackPorCargo(c) {\n  // c em lower\n  if (c.includes('admin')) {\n    // admin tudo liberado (pode ser refinado depois)\n    return {\n      dashboard: { visualizar: true, criar: true, editar: true, excluir: true },\n      clientes: { visualizar: true, criar: true, editar: true, excluir: true },\n      tickets: { visualizar: true, criar: true, editar: true, excluir: true },\n      entregas: { visualizar: true, criar: true, editar: true, excluir: true },\n      inbox: { visualizar: true, criar: true, editar: true, excluir: true },\n      evidencias: { visualizar: true, criar: true, editar: true, excluir: true },\n      listas: { visualizar: true, criar: true, editar: true, excluir: true },\n      funcionarios: { visualizar: true, criar: true, editar: true, excluir: true },\n      auditoria: { visualizar: true }\n    };\n  }\n  if (c.includes('auditor')) {\n    return {\n      dashboard: { visualizar: true },\n      clientes: { visualizar: true },\n      tickets: { visualizar: true },\n      entregas: { visualizar: true },\n      inbox: { visualizar: true },\n      evidencias: { visualizar: true },\n      listas: { visualizar: true },\n      auditoria: { visualizar: true }\n    };\n  }\n // operador (default) - sem permissao cadastrada = so visualizar, ate um admin liberar\n  return {\n    dashboard: { visualizar: true },\n    clientes: { visualizar: true },\n    tickets: { visualizar: true },\n    entregas: { visualizar: true },\n    inbox: { visualizar: true },\n    evidencias: { visualizar: true },\n    listas: { visualizar: true }\n  };\n}\n\nif (!hasModulos) {\n  modulos = fallbackPorCargo(cargo);\n}\n\n// Retornar em dois formatos (root e data) para compatibilidade\nreturn [{\n  json: {\n    success: true,\n    modulos,\n    clientesAcesso,\n    data: { modulos, clientesAcesso }\n  }\n}];\n"
      },
