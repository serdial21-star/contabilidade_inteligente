        "jsCode": "const auth = ($input.first().json.headers?.authorization || $input.first().json.headers?.Authorization || '').toString();\nconst token = auth.replace(/^Bearer\\s+/i,'').replace(/[^a-zA-Z0-9._-]/g,'');\nreturn [{ json: { token } }];"
