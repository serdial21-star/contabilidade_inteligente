      "parameters": {
        "jsCode": "const detail = $('Normalizar Recurso').first().json;\nconst input = $('Validar Entrada').first().json;\nconst data = detail.data ?? {};\nconst rawArea = String(data.area ?? data.area_responsavel ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase();\nconst subpasta = rawArea.includes('FISC') ? '01_FISCAL' : rawArea.includes('PESSO') ? '02_PESSOAL' : rawArea.includes('CONTAB') ? '03_CONTABIL' : rawArea.includes('SOCIET') ? '04_SOCIETARIO' : '99_DIVERSOS';\nreturn [{ json: { ...input, drive_folder_id: detail.drive_folder_id, subpasta }, binary: $input.first().binary }];"
