      "parameters": {
        "jsCode": "const raw = $input.first().json ?? {};\nconst headers = raw.headers ?? {};\nconst auth = String(headers.authorization ?? headers.Authorization ?? '');\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst rawId = String(body.ticket_id ?? '');\nconst parsedId = /^[1-9][0-9]*$/.test(rawId) ? Number(rawId) : 0;\nconst message = String(body.mensagem ?? '').trim();\nconst dataUri = String(body.arquivo_base64 ?? '');\nconst originalName = String(body.arquivo_nome ?? '').trim();\nconst hasFile = dataUri !== '' || originalName !== '';\nconst allowed = ['application/pdf', 'image/jpeg', 'image/png'];\nconst matchFile = dataUri.match(/^data:([^;,]+);base64,([A-Za-z0-9+/]+={0,2})$/);\nlet error = '';\nlet binary;\nlet mime = '';\nlet safeName = '';\nif (!match) error = 'unauthorized';\nelse if (!Number.isSafeInteger(parsedId) || parsedId < 1 || message.length > 5000 || (message === '' && !hasFile)) error = 'invalid_input';\nelse if (hasFile) {\n  if (!matchFile || originalName === '' || originalName.length > 255) error = 'invalid_file';\n  else {\n    mime = matchFile[1].toLowerCase();\n    if (!allowed.includes(mime)) error = 'invalid_file';\n    else {\n      const bytes = Buffer.from(matchFile[2], 'base64');\n      const magic = bytes.subarray(0, 8).toString('hex').toLowerCase();\n      const textStart = bytes.subarray(0, Math.min(bytes.length, 512)).toString('utf8').replace(/^\\uFEFF/, '').trimStart();\n      const signatureOk =\n        (mime === 'application/pdf' && bytes.subarray(0, 5).toString('ascii') === '%PDF-') ||\n        (mime === 'image/jpeg' && magic.startsWith('ffd8ff')) ||\n        (mime === 'image/png' && magic === '89504e470d0a1a0a') ||\n        (false && (mime === 'application/xml' || mime === 'text/xml') && textStart.startsWith('<') && !/<!DOCTYPE/i.test(textStart));\n      const expectedExt = mime === 'application/pdf' ? ['pdf'] : mime === 'image/jpeg' ? ['jpg', 'jpeg'] : mime === 'image/png' ? ['png'] : ['xml'];\n      const ext = originalName.includes('.') ? originalName.split('.').pop().toLowerCase() : '';\n      if (bytes.length === 0 || bytes.length > 10 * 1024 * 1024 || !signatureOk || !expectedExt.includes(ext)) error = 'invalid_file';\n      else {\n        safeName = originalName.replace(/[\\\\/:*?\"<>|\\x00-\\x1F]/g, '_').slice(0, 255);\n        binary = { data: { data: matchFile[2], mimeType: mime, fileName: safeName, fileSize: bytes.length } };\n      }\n    }\n  }\n}\nreturn [{ json: {\n  token: match ? match[1] : '', resource_id: parsedId, mensagem: message,\n  has_file: hasFile && !error, arquivo_nome: safeName, invalid_reason: error\n}, ...(binary ? { binary } : {}) }];"
