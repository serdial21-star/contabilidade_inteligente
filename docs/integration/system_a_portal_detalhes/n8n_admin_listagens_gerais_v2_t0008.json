    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.ticket_id, m.remetente_tipo, m.mensagem, m.anexo_url, DATE_FORMAT(m.criado_em, '%Y-%m-%dT%H:%i:%s') AS criado_em, CASE WHEN m.remetente_tipo = 'Equipe' THEN COALESCE(f.nome_funcionario, 'Equipe') ELSE COALESCE(c.nome_cliente, 'Cliente') END AS autor FROM tickets_mensagens m JOIN tickets_master t ON t.id = m.ticket_id LEFT JOIN funcionarios f ON m.remetente_tipo = 'Equipe' AND f.id = m.remetente_id LEFT JOIN clientes c ON c.id = t.cliente_id ORDER BY m.criado_em ASC, m.id ASC;",
        "options": {}
      },
      "id": "db98061a-b82b-4b67-807f-bfcd8c073e95",
      "name": "Buscar Mensagens",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.1,
      "position": [
        1232,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "mySql": {
          "id": "A8EKwXIiVjrNd53S",
          "name": "MySQL account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Junta a conversa (tickets_mensagens) a cada ticket, no formato que a gaveta de detalhes espera.\nconst tickets = $('Buscar Todos os Tickets').all().map((i) => i.json).filter((t) => t && t.id !== undefined && t.id !== null);\nconst mensagens = $input.all().map((i) => i.json).filter((m) => m && m.ticket_id !== undefined && m.ticket_id !== null);\n\nconst porTicket = {};\nfor (const m of mensagens) {\n  (porTicket[m.ticket_id] = porTicket[m.ticket_id] || []).push({\n    data: m.criado_em,\n    autor: m.autor || (m.remetente_tipo === 'Equipe' ? 'Equipe' : 'Cliente'),\n    mensagem: m.mensagem,\n    tipo: m.remetente_tipo,\n  });\n}\n\nif (tickets.length === 0) return [{ json: {} }];   // lista vazia (o nó de resposta descarta este item)\nreturn tickets.map((t) => ({ json: { ...t, historico: porTicket[t.id] || [] } }));"
      },
      "id": "cd989e3e-315e-41cc-a0bc-eb972f0fefc1",
      "name": "Anexar Histórico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// T-0008: o MariaDB devolve JSON como texto; converte complementos em lista sem alterar os demais campos.\nconst parse = (v) => { if (Array.isArray(v)) return v; if (typeof v !== 'string' || v === '') return []; try { const r = JSON.parse(v); return Array.isArray(r) ? r : []; } catch { return []; } };\nreturn $input.all().map((i) => ({ json: (i.json && i.json.id !== undefined && i.json.id !== null) ? { ...i.json, complementos: parse(i.json.complementos) } : i.json }));"
      },
      "id": "6b1e2f0a-0f9c-4d6e-9b1a-7c2d3e4f5a60",
      "name": "Converter Complementos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        208
      ]
    }
