    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst h = item.headers?.authorization || '';\n\n// Descobre qual dos dois webhooks disparou esta execução (o campo \"path\" não existe nesta versão do n8n).\nlet rota = String(item.path || '');\ntry { if ($('GET Tickets Admin').first()) rota = 'tickets'; } catch (e) { /* não foi este */ }\ntry { if ($('GET Documentos Admin').first()) rota = 'documentos'; } catch (e) { /* não foi este */ }\n\nreturn [{\n  json: {\n    token: h.replace(/^Bearer\\s+/i, '').replace(/[^a-zA-Z0-9]/g, ''),\n    rota\n  }\n}];"
      },
      "id": "d512025d-db74-49eb-92ab-9de76f3e451e",
      "name": "Extrair Token e Rota",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.id, f.cargo FROM security_sessoes_funcionarios s JOIN funcionarios f ON s.funcionario_id = f.id WHERE s.token_hash = SHA2('{{ $json.token }}', 256) AND s.expira_em > NOW() AND s.revogado_em IS NULL AND f.status = 'Ativo' LIMIT 1;",
        "options": {}
      },
