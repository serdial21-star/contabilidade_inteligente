    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id, t.numero_ticket, t.assunto, t.descricao, t.status, t.area, t.prioridade, DATE_FORMAT(t.criado_em, '%Y-%m-%dT%H:%i:%s') AS criado_em, COALESCE(c.nome_cliente, '—') AS nome_cliente FROM tickets_master t LEFT JOIN clientes c ON t.cliente_id = c.id ORDER BY t.criado_em DESC;",
        "options": {}
      },
      "id": "456e9485-ca4f-43e0-89fc-cafe61faa3c3",
      "name": "Buscar Todos os Tickets",
      "type": "n8n-nodes-base.mySql",
