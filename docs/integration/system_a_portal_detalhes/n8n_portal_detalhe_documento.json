      "parameters": {
        "jsCode": "const raw = $input.first().json ?? {};\nconst headers = raw.headers ?? {};\nconst auth = String(headers.authorization ?? headers.Authorization ?? '');\nconst match = auth.match(/^Bearer\\s+([A-Za-z0-9]{20,128})$/i);\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst rawId = String(body.documento_id ?? '');\nconst parsedId = /^[1-9][0-9]*$/.test(rawId) ? Number(rawId) : 0;\nreturn [{ json: {\n  token: match ? match[1] : '',\n  resource_id: Number.isSafeInteger(parsedId) ? parsedId : 0,\n  invalid_input: !match || !Number.isSafeInteger(parsedId) || parsedId < 1\n} }];"
