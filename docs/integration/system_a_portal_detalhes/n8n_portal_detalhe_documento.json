    {
      "parameters": {
        "jsCode": "const values = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]);\nconst row = values.find((value) => value && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, 'result'));\nif (!row) return [{ json: { success: false, result: 'error' } }];\nif (row.result !== 'found') return [{ json: { success: false, result: row.result } }];\nconst parseList = (value) => {\n  if (Array.isArray(value)) return value;\n  if (typeof value !== 'string' || value === '') return [];\n  try { const parsed = JSON.parse(value); return Array.isArray(parsed) ? parsed : []; } catch { return []; }\n};\nreturn [{ json: { success: true, result: 'found', drive_folder_id: row.drive_folder_id, data: {\n  ...row,\n  success: undefined,\n  result: undefined,\n  drive_folder_id: undefined,\n  complementos: parseList(row.complementos),\n  anexos_abertura: parseList(row.anexos_abertura)\n} } }];"
      },
