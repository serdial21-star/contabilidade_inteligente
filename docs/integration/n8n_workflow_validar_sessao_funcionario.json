    {
      "parameters": {
        "jsCode": "const auth = ($input.first().json.headers?.authorization || $input.first().json.headers?.Authorization || '').toString();\nconst token = auth.replace(/^Bearer\\s+/i,'').replace(/[^a-zA-Z0-9]/g,'');\nreturn [{ json: { token } }];"
      },
      "id": "a1b2c3d4-0004-4a11-8001-000000000004",
      "name": "Extrair Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.id AS funcionario_id, f.status FROM security_sessoes_funcionarios s JOIN funcionarios f ON s.funcionario_id = f.id WHERE s.token_hash = SHA2('{{ $json.token }}', 256) AND s.expira_em > NOW() AND s.revogado_em IS NULL AND f.status = 'Ativo' LIMIT 1;",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4a11-8001-000000000005",
