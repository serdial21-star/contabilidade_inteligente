# Copie para .env.mysql-homologation fora do versionamento e preencha no cofre/ambiente.
# Banco dedicado, vazio e descartável; nunca use produção nesta homologação.
SERDIAL21_ENVIRONMENT=development
SERDIAL21_DEBUG=false
SERDIAL21_LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://serdial21_homologation:replace_me@127.0.0.1:3306/serdial21_homologation
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_READ_TIMEOUT_SECONDS=30
DATABASE_WRITE_TIMEOUT_SECONDS=30
OBJECT_STORAGE_PATH=.serdial21-storage-homologation
DOCUMENT_MAX_UPLOAD_BYTES=10485760
NFE_MAX_XML_BYTES=5242880
NFE_MAX_XML_ELEMENTS=100000
