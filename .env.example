# Copie para .env e substitua os valores apenas no ambiente local.
SERDIAL21_ENVIRONMENT=development
SERDIAL21_DEBUG=false
SERDIAL21_LOG_LEVEL=INFO
SERDIAL21_API_PREFIX=/api/v1
# Exemplo sem credencial real:
DATABASE_URL=mysql+pymysql://serdial21:replace_me@127.0.0.1:3306/serdial21
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_READ_TIMEOUT_SECONDS=30
DATABASE_WRITE_TIMEOUT_SECONDS=30
# Identidade externa OIDC; use somente valores emitidos pelo IdP aprovado.
OIDC_ISSUER=https://id.example.invalid
OIDC_AUDIENCE=serdial21-api
OIDC_JWKS_URL=https://id.example.invalid/.well-known/jwks.json
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_JWKS_TIMEOUT_SECONDS=5
OBJECT_STORAGE_PATH=.serdial21-storage
DOCUMENT_MAX_UPLOAD_BYTES=10485760
NFE_MAX_XML_BYTES=5242880
NFE_MAX_XML_ELEMENTS=100000
