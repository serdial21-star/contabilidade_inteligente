{
    admin off
    auto_https off
    servers {
        # Esta instancia e interna e recebe trafego somente do proxy publico
        # pela rede Docker privada. Preserva a origem que esse proxy sanitizou.
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}
:8080 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /app/* {
        root * /srv
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        header X-Frame-Options "DENY"
        file_server
    }

    handle /ui/* {
        root * /srv
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        header X-Frame-Options "DENY"
        file_server
    }

    handle / {
        redir /app/ 302
    }

    handle {
        respond "Not found" 404
    }
}
